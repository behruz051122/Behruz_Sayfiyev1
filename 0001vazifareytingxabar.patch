+def _build_paid_group_report_text(tests, homeworks) -> str:
+    parts = ["📅 <b>Kechagi kun natijangiz</b>\n"]
+
+    if tests:
+        parts.append("🎓 <b>Nazorat testi:</b>")
+        for t in tests:
+            parts.append(f"  • {t['test_title']}: {t['score']}/{t['total_questions']} ({t['percent']}%)")
+    else:
+        parts.append("⚠️ Kecha nazorat testi ishlamadingiz.")
+
+    parts.append("")
+
+    if homeworks:
+        parts.append("📸 <b>Vazifa:</b>")
+        for h in homeworks:
+            if h.get("teacher_score") is not None:
+                score_txt = f" — {h['teacher_score']}/10"
+            else:
+                score_txt = " (baholanmoqda)"
+            parts.append(f"  • {h['subject_title']}, {h['paragraph_number']}-paragraf{score_txt}")
+    else:
+        parts.append("⚠️ Kecha vazifa tashlamadingiz.")
+
+    return "\n".join(parts)
+
+
+async def send_paid_group_daily_report_loop():
+    """Har 2 kunda bir marta, soat 23:00'da (Toshkent vaqti), pullik
+    (kirish guruhiga a'zo) har bir foydalanuvchiga KECHAGI kunning nazorat
+    testi va vazifa natijasini (yoki yo'qligi haqida ogohlantirishni)
+    yuboradi.
+
+    "Har 2 kunda bir marta" qoidasi paid_group_daily_notifications
+    jadvalidagi oxirgi yuborilgan sana orqali ta'minlanadi — shu sabab
+    sikl har kuni soat 23:00'da ishga tushsa ham, aynan shu foydalanuvchiga
+    2 kundan kam vaqt o'tgan bo'lsa, xabar qayta yuborilmaydi."""
+    while True:
+        try:
+            now = _tashkent_now()
+            if now.hour == PAID_GROUP_REPORT_HOUR:
+                today_str = now.date().isoformat()
+                yesterday_str = (now.date() - datetime.timedelta(days=1)).isoformat()
+                due_ids = get_users_due_for_paid_group_report(today_str)
+                for tid in due_ids:
+                    try:
+                        tests = get_yesterday_control_test_results_for(tid, yesterday_str)
+                        homeworks = get_yesterday_homework_submissions_for(tid, yesterday_str)
+                        text = _build_paid_group_report_text(tests, homeworks)
+                        await bot.send_message(tid, text, parse_mode="HTML")
+                        mark_paid_group_report_sent(tid, today_str)
+                        logging.info(f"Pullik guruh kunlik hisoboti yuborildi: telegram_id={tid}")
+                    except Exception as send_error:
+                        logging.warning(f"Pullik guruh hisoboti yuborilmadi (telegram_id={tid}): {send_error}")
+        except Exception as e:
+            logging.error(f"Pullik guruh hisobot siklida xato: {e}")
+
+        await asyncio.sleep(PAID_GROUP_REPORT_CHECK_INTERVAL_SECONDS)
+
+
